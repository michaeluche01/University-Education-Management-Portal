# Neon PostgreSQL pooled connection string (PgBouncer / -pooler hostname)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# 32+ character secret used to sign httpOnly JWT session cookies (jose)
SESSION_SECRET="replace-with-at-least-32-chars-random-secret-key"

# Optional: Public canonical application URL for CSRF origin matching
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Optional: Safety guards for demo reset scripts
# RESET_CONFIRM="wipe-all-data"
# CONFIRM_PROD="yes"
# EXPECTED_DB_HOST="example-neon-host"
# ALLOW_NON_DEMO_USERS="no"
# PROD_DB_HOST="production-host.neon.tech"
